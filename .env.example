# =============================================================================
# ai-agent-ebook-funnel — environment template
# Copy to .env.local for development. Never commit the filled version.
# Every value below is REQUIRED unless marked OPTIONAL.
# The app fails fast at boot if a required one is missing (see src/config/env.ts).
# =============================================================================

# --- Core -------------------------------------------------------------------
# Public origin, no trailing slash. Used to build redirect/webhook/download URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"

# --- Database (Neon) --------------------------------------------------------
# Pooled connection string from the Neon dashboard.
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# --- Secrets ----------------------------------------------------------------
# 32+ random bytes, hex or base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# SESSION_SECRET signs admin session cookies.
SESSION_SECRET=""
# DOWNLOAD_SECRET signs time-limited download tokens for the paid PDF.
DOWNLOAD_SECRET=""

# --- Payments: UddoktaPay / Paymently --------------------------------------
# Panel base URL. With or without a trailing "/api" — both are accepted.
# Sandbox: https://sandbox.uddoktapay.com   Live: your own panel host.
UDDOKTAPAY_BASE_URL="https://sandbox.uddoktapay.com"
# Sent as the RT-UDDOKTAPAY-API-KEY header on API calls, and required to match
# on inbound webhooks. The documented sandbox key is 982d381360a69d419689740d9f2e26ce36fb7a50
UDDOKTAPAY_API_KEY=""

# --- Email (Resend) ---------------------------------------------------------
# OPTIONAL in development. If unset, delivery emails are logged, not sent,
# and the order is still completed. Email failure never rolls back a paid order.
RESEND_API_KEY=""
MAIL_FROM="Corieosity <noreply@example.com>"
# Where new-order alerts go. OPTIONAL.
ADMIN_ALERT_EMAIL=""

# --- Scheduled jobs ---------------------------------------------------------
# Bearer token Vercel Cron must present to /api/cron/*. Generate like the
# secrets above. Without it the cron endpoints reject every request.
CRON_SECRET=""

# --- Product file delivery --------------------------------------------------
# Absolute URL of the private, non-public bundle. The app never redirects the
# buyer here directly; it streams the bytes behind a signed token.
# Leave empty in development to serve tests/fixtures/sample.pdf instead.
EBOOK_FILE_URL=""

# --- Admin bootstrap --------------------------------------------------------
# Used ONCE by `npm run db:seed` to create the first super-admin, then ignored.
# Change the password immediately after first login.
ADMIN_BOOTSTRAP_EMAIL=""
ADMIN_BOOTSTRAP_PASSWORD=""

# --- Tracking (all OPTIONAL; the funnel works fully with none of them) ------
# Meta Pixel, browser side.
NEXT_PUBLIC_META_PIXEL_ID=""
# Meta Conversions API, server side. Shares event_id with the browser for dedup.
META_CAPI_ACCESS_TOKEN=""
# OPTIONAL: only needed while testing CAPI in Events Manager.
META_CAPI_TEST_EVENT_CODE=""
# GA4 measurement id, browser side.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=""
